SESSION_SECRET=замени-на-случайную-длинную-строку
NODE_ENV=development
PORT=3000

# Строка подключения к базе данных Supabase (PostgreSQL).
# Взять в Supabase: Project -> Connect -> Session pooler -> Connection string
# Не коммить реальное значение в Git — только в .env локально и в Render Environment.
DATABASE_URL=postgresql://postgres.xxxxxxxx:ПАРОЛЬ@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Необязательно: Incoming Webhook URL Discord-канала, куда будут падать
# уведомления о новых челленджах/демках/сообщениях поддержки/запросах
# на восстановление пароля. Discord -> Настройки канала -> Интеграции ->
# Вебхуки -> Создать вебхук -> Копировать URL.
# Если не задать — сайт просто не будет слать уведомления в Discord,
# остальной функционал не пострадает.
DISCORD_WEBHOOK_URL=
